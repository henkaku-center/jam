{
  "name": "jam",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "npm run build:strudel-editor && node server.js",
    "build:strudel-editor": "node scripts/build-strudel-editor.mjs",
    "jam": "node scripts/jamctl.mjs",
    "agent": "node scripts/agent-worktree.mjs",
    "validate:quick": "node scripts/agent-worktree.mjs validate",
    "validate:full": "node scripts/agent-worktree.mjs validate --full",
    "smoke:live": "node scripts/live-smoke.mjs",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "sessions:manifest": "node scripts/generate-sessions-manifest.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@strudel/codemirror": "^1.3.0",
    "@strudel/core": "^1.2.6",
    "@strudel/draw": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/web": "^1.3.0",
    "@strudel/webaudio": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-pty": "^1.1.0",
    "ws": "^8.16.0",
    "y-codemirror.next": "^0.3.5",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.28.1"
  }
}
